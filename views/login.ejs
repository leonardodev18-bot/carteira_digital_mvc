<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Controle de Gastos | Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap"
    rel="stylesheet">
  <style>
    body {
      font-family: 'Montserrat', sans-serif;
      background-color: #07101c;
      color: #fff;
      min-height: 100vh;
    }

    .glass-card {
      background: linear-gradient(145deg, rgba(27, 54, 93, 0.5) 0%, rgba(7, 16, 28, 0.85) 100%);
      border: 1px solid rgba(96, 193, 229, 0.35);
      border-radius: 20px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
    }

    .form-control-dark {
      background-color: rgba(7, 16, 28, 0.8);
      border: 1px solid rgba(96, 193, 229, 0.4);
      color: #fff;
      border-radius: 12px;
      padding: 10px 14px;
    }

    .form-control-dark:focus {
      background-color: rgba(7, 16, 28, 0.95);
      color: #fff;
      border-color: #60C1E5;
      box-shadow: 0 0 12px rgba(96, 193, 229, 0.3);
    }

    .btn-neon {
      background: linear-gradient(135deg, #005A9C, #60C1E5);
      color: #fff;
      border: none;
      border-radius: 50px;
      padding: 10px 24px;
      font-weight: 800;
    }
  </style>
</head>

<body class="d-flex align-items-center justify-content-center py-4">
  <div class="glass-card p-4 p-md-5" style="max-width: 440px; width: 100%;">
    <div class="text-center mb-4">
      <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
        style="width: 64px; height: 64px; background: rgba(96, 193, 229, 0.15); border: 1.5px solid #60C1E5;">
        <i class="bi bi-wallet2 fs-2" style="color: #60C1E5;"></i>
      </div>
      <h3 class="fw-black mb-0">Controle de <span style="color: #60C1E5;">Gastos</span></h3>
    </div>

    <% if (erro) { %>
      <div class="alert alert-danger py-2 small">
        <%= erro %>
      </div>
      <% } %>

        <form action="/login" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label class="form-label small fw-semibold" style="color: #A0E0EF;">E-mail</label>
            <input type="email" name="email" class="form-control form-control-dark" placeholder="Digite seu e-mail"
              required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold" style="color: #A0E0EF;">Senha</label>
            <input type="password" name="senha" minlength="8" class="form-control form-control-dark"
              placeholder="Mínimo 8 caracteres" required>
          </div>
          <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" name="lembrar" value="true" id="lembrar" checked>
            <label class="form-check-label small text-white-50" for="lembrar">Manter conectado</label>
          </div>
          <button type="submit" class="btn btn-neon w-100">
            Entrar na Carteira <i class="bi bi-box-arrow-in-right ms-1"></i>
          </button>
        </form>
  </div>
</body>

</html>